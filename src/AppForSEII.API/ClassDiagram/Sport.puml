@startuml
class Sport {
    + Id : int <<get>> <<set>>
    + Name : string <<get>> <<set>> = "Game"
    + MinimumNumberofPlayers : int <<get>> <<set>> = 2
    + NumberofReferees : int <<get>> <<set>> = 1
    + Description : string <<get>> <<set>> = "Description"
    + BasicRules : string <<get>> <<set>> = "Rules for the game"
}
@enduml
