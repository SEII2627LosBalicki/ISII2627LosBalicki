@startuml
class Referee {
    + Referee()
    + Referee(id:string, name:string, surname:string, userName:string, rating:int, yearsRefereeing:int)
    + Rating : int <<get>> <<set>>
    + YearsRefereeing : int <<get>> <<set>>
    + SportId : int? <<get>> <<set>>
    + SportForReferee : Sport? <<get>> <<set>>
    + RefereeAssignedTos : ICollection<RefereeAssignedTo> <<get>> <<set>>
}
ApplicationUser <|-- Referee
@enduml
