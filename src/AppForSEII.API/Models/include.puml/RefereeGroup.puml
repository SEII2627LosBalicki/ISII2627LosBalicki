@startuml
class RefereeGroup {
    + RefereeGroup()
    + RefereeGroup(name:string, gameId:int, description:string?, rules:string?)
    + Id : int <<get>> <<set>>
    + Name : string <<get>> <<set>> = "Name between 3 and 20 chars."
    + Description : string? <<get>> <<set>>
    + Rules : string? <<get>> <<set>>
    + GameId : int <<get>> <<set>>
    + Game : Game? <<get>> <<set>>
    + RefereeAssignedTos : ICollection<RefereeAssignedTo> <<get>> <<set>>
}
@enduml
