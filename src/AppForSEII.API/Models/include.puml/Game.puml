@startuml
class Game {
    + Game()
    + Game(name:string, date:DateTime, place:string, description:string?)
    + Id : int <<get>> <<set>>
    + Name : string <<get>> <<set>> = ""
    + Date : DateTime <<get>> <<set>>
    + Place : string <<get>> <<set>> = "More than 5 characters"
    + Description : string? <<get>> <<set>>
    + ResponsibleForId : string? <<get>> <<set>>
    + ResponsibleFor : ApplicationUser? <<get>> <<set>>
    + SportId : int? <<get>> <<set>>
    + Sport : Sport? <<get>> <<set>>
    + RefereeGroups : ICollection<RefereeGroup> <<get>> <<set>>
}
@enduml
